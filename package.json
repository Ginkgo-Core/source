{
  "name": "ginkgo-leaf",
  "version": "0.1.0",
  "private": true,
  "description": "Ginkgo Leaf — Multi-tenant AI agent platform for Brazilian SMBs",
  "author": "Ginkgo AI Systems <gabriel@ginkgosystems.tech>",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.1.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "clean": "turbo clean",
