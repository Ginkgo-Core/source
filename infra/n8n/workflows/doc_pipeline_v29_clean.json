    {
      "parameters": {
        "jsCode": "// Converte o arquivo binário baixado para base64\nconst binaryKey = Object.keys(items[0].binary || {})[0];\nif (!binaryKey) throw new Error('Nenhum arquivo binário encontrado no input');\n\nconst binaryData = items[0].binary[binaryKey];\nconst buffer = await this.helpers.getBinaryDataBuffer(0, binaryKey);\nconst base64 = buffer.toString('base64');\n\nreturn [{\n  json: {\n    ...items[0].json,\n    fileBase64: base64,\n    fileName: binaryData.fileName || 'documento.pdf',\n    mimeType: binaryData.mimeType || 'application/octet-stream',\n    fileSize: buffer.length\n  }\n}];"
      },
