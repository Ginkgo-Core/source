    {
      "id": "d520866d-5013-4f12-9b8a-d7dc617cd2f1",
      "name": "Doc → Base64",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        352,
        400
      ],
      "parameters": {
        "jsCode": "const item = $input.item;\nconst binaryData = item.binary?.data;\nif (!binaryData) throw new Error('Nenhum dado binário encontrado');\n\nconst buffer = await this.helpers.getBinaryDataBuffer(item, 'data');\nconst base64 = buffer.toString('base64');\nconst fileName = binaryData.fileName || 'documento.pdf';\nconst mimeType = binaryData.mimeType || 'application/pdf';\n\nreturn [{\n  json: {\n    ...item.json,\n    fileBase64: base64,\n    fileName: fileName,\n    mimeType: mimeType,\n    fileSize: buffer.length\n  },\n  binary: item.binary\n}];"
      }
    },
    {
      "id": "45dc9a4d-33fe-4bbe-bed6-205fba209f85",
      "name": "HTTP Upload Manus",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        576,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.manus.ai/v1/files",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={\"filename\": \"{{ $json.fileName }}\"}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "manus-api-key",
          "name": "Manus API Key"
        }
      }
    },
    {
      "id": "25f1180d-1e7c-4302-9d3c-d985bba522e3",
      "name": "PUT Upload S3",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        400
      ],
      "parameters": {
        "jsCode": "const uploadUrl = $('HTTP Upload Manus').item.json.upload_url;\nconst fileId    = $('HTTP Upload Manus').item.json.id;\nconst base64    = $('Doc → Base64').item.json.fileBase64;\nconst mimeType  = $('Doc → Base64').item.json.mimeType;\nconst fileName  = $('Doc → Base64').item.json.fileName;\nconst numeroLead = $input.item.json.numero_lead || null;\n\nif (!uploadUrl) throw new Error('upload_url não encontrado na resposta do POST /v1/files');\nif (!base64)    throw new Error('fileBase64 não encontrado');\n\nconst buffer = Buffer.from(base64, 'base64');\n\nconst response = await this.helpers.request({\n  method: 'PUT',\n  url: uploadUrl,\n  body: buffer,\n  headers: { 'Content-Type': mimeType },\n  encoding: null,\n  resolveWithFullResponse: true\n});\n\nif (response.statusCode >= 400) {\n  throw new Error(`PUT S3 falhou: ${response.statusCode} - ${response.body}`);\n}\n\nreturn [{\n  json: {\n    file_id: fileId,\n    upload_status: response.statusCode,\n    fileName: fileName,\n    mimeType: mimeType,\n    numero_lead: numeroLead,\n    polling_count: 0,\n    started_at: Date.now()\n  }\n}];"
      }
    },
    {
      "id": "7b4e5db6-295b-4f72-b162-ea335bb72944",
      "name": "Criar Task Transcrição",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1024,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.manus.ai/v1/tasks",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={\n  \"prompt\": \"Analise e transcreva completamente o conteúdo deste documento. Extraia todo o texto, tabelas, listas e informações relevantes. Retorne o conteúdo completo de forma organizada e estruturada em português.\",\n  \"agentProfile\": \"manus-1.6-lite\",\n  \"taskMode\": \"chat\",\n  \"hideInTaskList\": true,\n  \"attachments\": [\n    {\n      \"type\": \"file_id\",\n      \"file_id\": \"{{ $json.file_id }}\"\n    }\n  ]\n}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "manus-api-key",
          "name": "Manus API Key"
        }
      }
    },
    {
      "id": "9e1b171e-6d34-438b-8e41-f7c094dbc8d2",
