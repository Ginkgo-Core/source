    {
      "id": "dcdd98a5-fe7d-4396-a6e7-85d6ba163649",
      "name": "Verificar Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1696,
        400
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Status que indicam conclusão\nconst DONE_STATUSES   = ['completed', 'succeeded', 'done', 'finished'];\n// Status que indicam erro permanente\nconst ERROR_STATUSES  = ['failed', 'error', 'cancelled', 'canceled'];\n// Máximo de tentativas antes de desistir (20 * 15s = 5 minutos)\nconst MAX_POLLS = 20;\n\nconst status       = ($json.status || '').toLowerCase();\nconst pollingCount = ($('PUT Upload S3').item.json.polling_count || 0) + 1;\nconst startedAt    = $('PUT Upload S3').item.json.started_at || Date.now();\nconst elapsedMs    = Date.now() - startedAt;\n\n// Log para debug\nconsole.log(`Poll #${pollingCount} | Status: ${status} | Elapsed: ${Math.round(elapsedMs/1000)}s`);\n\n// Timeout de segurança: 5 minutos\nif (pollingCount > MAX_POLLS || elapsedMs > 300000) {\n  return [{\n    json: {\n      ...$json,\n      routing: 'timeout',\n      polling_count: pollingCount,\n      elapsed_seconds: Math.round(elapsedMs / 1000),\n      error_message: `Timeout após ${pollingCount} tentativas (${Math.round(elapsedMs/1000)}s)`\n    }\n  }];\n}\n\nif (DONE_STATUSES.includes(status)) {\n  return [{\n    json: {\n      ...$json,\n      routing: 'done',\n      polling_count: pollingCount,\n      elapsed_seconds: Math.round(elapsedMs / 1000)\n    }\n  }];\n}\n\nif (ERROR_STATUSES.includes(status)) {\n  return [{\n    json: {\n      ...$json,\n      routing: 'timeout',\n      polling_count: pollingCount,\n      error_message: `Task falhou com status: ${status}`\n    }\n  }];\n}\n\n// Ainda processando\nreturn [{\n  json: {\n    ...$json,\n    routing: 'wait',\n    polling_count: pollingCount,\n    elapsed_seconds: Math.round(elapsedMs / 1000)\n  }\n}];"
      }
    },
