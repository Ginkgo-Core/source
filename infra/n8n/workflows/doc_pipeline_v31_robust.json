            {
              "id": "e77ab320-02b7-412c-a19a-8fe0f95e7db0",
              "name": "texto_transcrito",
              "value": "={{ \n  (() => {\n    const out = $json.output || [];\n    // Formato 1: output[].content[].text (role=assistant)\n    const f1 = out\n      .filter(m => m.role === 'assistant')\n      .flatMap(m => (m.content || []))\n      .filter(c => c.type === 'output_text')\n      .map(c => c.text)\n      .join('\\n\\n');\n    if (f1) return f1;\n    // Formato 2: output[].content direto como string\n    const f2 = out\n      .filter(m => m.role === 'assistant')\n      .map(m => typeof m.content === 'string' ? m.content : '')\n      .join('\\n\\n');\n    if (f2) return f2;\n    // Formato 3: campo result direto\n    return $json.result || $json.content || $json.text || '[sem transcrição]';\n  })()\n}}",
              "type": "string"
            },
            {
              "id": "53c3735d-8287-4833-95ee-5b370d721ba5",
