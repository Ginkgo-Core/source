        "unit": "seconds",
        "value": 20
      },
      "webhookId": "05f5f314-71e8-40b5-ad3e-fa7a843874a1"
    },
    {
      "id": "62699ebc-bfd3-49c3-a225-1c82fa69188f",
      "name": "GET Status Task",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1472,
        400
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://api.manus.ai/v1/tasks/{{ $('Criar Task Transcrição').item.json.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
