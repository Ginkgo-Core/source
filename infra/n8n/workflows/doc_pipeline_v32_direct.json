    {
      "id": "11a3ca86-efe2-4f92-8a31-210e14b0c462",
      "name": "Doc → Base64",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        352,
        400
      ],
      "parameters": {
        "jsCode": "const item = $input.item;\nconst binaryData = item.binary?.data;\nif (!binaryData) throw new Error('Nenhum dado binário encontrado no input');\n\nconst buffer = await this.helpers.getBinaryDataBuffer(item, 'data');\nconst base64 = buffer.toString('base64');\nconst fileName = binaryData.fileName || 'documento.pdf';\nconst mimeType = binaryData.mimeType || 'application/pdf';\n\nreturn [{\n  json: {\n    ...item.json,\n    fileBase64: base64,\n    fileName: fileName,\n    mimeType: mimeType,\n    fileSize: buffer.length,\n    started_at: Date.now(),\n    polling_count: 0\n  }\n}];"
      }
    },
    {
      "id": "ba2d2b2b-3f8f-4534-b1de-80486e3a7c20",
      "name": "Criar Task Transcrição",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        576,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.manus.ai/v1/tasks",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={\n  \"prompt\": \"Analise e transcreva completamente o conteúdo deste documento. Extraia todo o texto, tabelas, listas e informações relevantes. Retorne o conteúdo completo de forma organizada e estruturada em português.\",\n  \"agentProfile\": \"manus-1.6-lite\",\n  \"taskMode\": \"chat\",\n  \"hideInTaskList\": true,\n  \"attachments\": [\n    {\n      \"type\": \"base64\",\n      \"data\": \"{{ $json.fileBase64 }}\",\n      \"media_type\": \"{{ $json.mimeType }}\",\n      \"filename\": \"{{ $json.fileName }}\"\n    }\n  ]\n}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "manus-api-key",
          "name": "Manus API Key"
        }
      }
    },
    {
      "id": "96e746d3-d12d-4e4c-a809-ae7f433a3bb2",
      "name": "Wait Inicial",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        800,
        400
      ],
