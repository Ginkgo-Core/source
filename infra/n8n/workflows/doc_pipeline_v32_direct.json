        "unit": "seconds",
        "value": 25
      },
      "webhookId": "9b08b1f7-fe21-4bd1-a4be-0db8670fa1dd"
    },
    {
      "id": "04a6ac4f-4586-44de-9cc0-d8f899c80ea8",
      "name": "GET Status Task",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1024,
        400
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://api.manus.ai/v1/tasks/{{ $('Criar Task Transcrição').item.json.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "manus-api-key",
          "name": "Manus API Key"
        }
      }
    },
    {
      "id": "96b2e478-b1d7-4dd8-9618-70326b2df286",
      "name": "Verificar Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1248,
        400
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const DONE   = ['completed', 'succeeded', 'done', 'finished'];\nconst ERRORS = ['failed', 'error', 'cancelled', 'canceled'];\nconst MAX_POLLS = 20;  // 20 * 15s = 5 minutos\n\nconst status       = ($json.status || '').toLowerCase();\nconst pollingCount = ($('Doc → Base64').item.json.polling_count || 0) + 1;\nconst startedAt    = $('Doc → Base64').item.json.started_at || Date.now();\nconst elapsedMs    = Date.now() - startedAt;\n\nconsole.log(`Poll #${pollingCount} | Status: \"${status}\" | Elapsed: ${Math.round(elapsedMs/1000)}s`);\n\n// Timeout de segurança\nif (pollingCount > MAX_POLLS || elapsedMs > 300000) {\n  return [{ json: { ...$json, routing: 'timeout', polling_count: pollingCount,\n    elapsed_seconds: Math.round(elapsedMs/1000),\n    error_message: `Timeout após ${pollingCount} tentativas (${Math.round(elapsedMs/1000)}s)` }}];\n}\n\nif (DONE.includes(status)) {\n  return [{ json: { ...$json, routing: 'done', polling_count: pollingCount,\n    elapsed_seconds: Math.round(elapsedMs/1000) }}];\n}\n\nif (ERRORS.includes(status)) {\n  return [{ json: { ...$json, routing: 'timeout', polling_count: pollingCount,\n    error_message: `Task falhou com status: ${status}` }}];\n}\n\n// Ainda processando\nreturn [{ json: { ...$json, routing: 'wait', polling_count: pollingCount,\n  elapsed_seconds: Math.round(elapsedMs/1000) }}];"
      }
    },
