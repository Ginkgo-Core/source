        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={\n  \"prompt\": \"Analise e transcreva completamente o conteúdo deste documento. Extraia todo o texto, tabelas, listas e informações relevantes. Retorne o conteúdo completo de forma organizada e estruturada em português.\",\n  \"agentProfile\": \"manus-1.6-lite\",\n  \"taskMode\": \"chat\",\n  \"hideInTaskList\": true,\n  \"attachments\": [\n    {\n      \"type\": \"base64\",\n      \"data\": \"{{ $json.fileBase64 }}\",\n      \"media_type\": \"{{ $json.mimeType }}\",\n      \"filename\": \"{{ $json.fileName }}\"\n    }\n  ]\n}",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "bEBj72wrDwAOpbL7",
          "name": "Header Auth account 2"
        }
