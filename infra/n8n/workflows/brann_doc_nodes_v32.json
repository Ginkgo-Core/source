            {
              "id": "13cbb098-289b-4897-99a1-db901cbe1bb6",
              "name": "texto_transcrito",
              "value": "={{ \n(() => {\n  const out = $json.output || [];\n  // Formato 1: output[].content[].text (role=assistant, type=output_text)\n  const f1 = out\n    .filter(m => m.role === 'assistant')\n    .flatMap(m => Array.isArray(m.content) ? m.content : [])\n    .filter(c => c.type === 'output_text')\n    .map(c => c.text || '')\n    .join('\\n\\n')\n    .trim();\n  if (f1) return f1;\n  // Formato 2: content como string direta\n  const f2 = out\n    .filter(m => m.role === 'assistant')\n    .map(m => typeof m.content === 'string' ? m.content : '')\n    .join('\\n\\n')\n    .trim();\n  if (f2) return f2;\n  // Formato 3: campos diretos\n  return $json.result || $json.content || $json.text || '[sem transcrição]';\n})()\n}}",
              "type": "string"
            },
