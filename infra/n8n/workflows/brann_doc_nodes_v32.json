    {
      "id": "689a969a-ae49-4c45-b9d5-a99de5ee82ad",
      "name": "Doc → Base64",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        576,
        1312
      ],
      "parameters": {
        "jsCode": "// Detecta a chave binária correta e extrai base64 + metadados reais\nconst item = items[0];\nconst binaryKeys = Object.keys(item.binary || {});\nif (!binaryKeys.length) throw new Error('Nenhum arquivo binário encontrado');\n\nconst binaryKey = binaryKeys[0];\nconst binaryData = item.binary[binaryKey];\nconst buffer = await this.helpers.getBinaryDataBuffer(0, binaryKey);\nconst base64 = buffer.toString('base64');\n\n// Detecta mimeType real a partir da assinatura do arquivo (magic bytes)\nlet detectedMime = binaryData.mimeType || 'application/octet-stream';\nconst magic = buffer.slice(0, 4).toString('hex');\nif (magic.startsWith('25504446')) detectedMime = 'application/pdf';\nelse if (magic.startsWith('504b0304')) detectedMime = 'application/vnd.openxmlformats-officedocument.wordprocessingml.document';\nelse if (magic.startsWith('d0cf11e0')) detectedMime = 'application/msword';\nelse if (magic.startsWith('ffd8ff'))   detectedMime = 'image/jpeg';\nelse if (magic.startsWith('89504e47')) detectedMime = 'image/png';\n\n// Detecta extensão do arquivo\nconst rawName = binaryData.fileName || item.json.fileName || 'documento';\nconst hasExt = rawName.includes('.');\nconst fileName = hasExt ? rawName : rawName + '.pdf';\n\nreturn [{\n  json: {\n    ...item.json,\n    fileBase64: base64,\n    fileName: fileName,\n    mimeType: detectedMime,\n    fileSize: buffer.length,\n    started_at: Date.now(),\n    polling_count: 0\n  }\n}];"
      }
    },
    {
      "id": "75732632-81f4-45ab-9e4b-261d6f1b8d4f",
      "name": "Criar Task Transcrição",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        1312
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.manus.ai/v1/tasks",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
