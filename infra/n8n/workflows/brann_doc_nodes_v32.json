    {
      "id": "0f5c5865-81f2-4cf5-a38b-eac29e114532",
      "name": "Verificar Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1472,
        1312
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const DONE   = ['completed', 'succeeded', 'done', 'finished'];\nconst ERRORS = ['failed', 'error', 'cancelled', 'canceled'];\nconst MAX_POLLS = 20;\n\nconst status       = ($json.status || '').toLowerCase();\nconst pollingCount = ($('Doc → Base64').item.json.polling_count || 0) + 1;\nconst startedAt    = $('Doc → Base64').item.json.started_at || Date.now();\nconst elapsedMs    = Date.now() - startedAt;\n\nconsole.log(`Poll #${pollingCount} | Status: \"${status}\" | Elapsed: ${Math.round(elapsedMs/1000)}s`);\n\nif (pollingCount > MAX_POLLS || elapsedMs > 300000) {\n  return [{ json: { ...$json, routing: 'timeout', polling_count: pollingCount,\n    elapsed_seconds: Math.round(elapsedMs/1000),\n    error_message: `Timeout após ${pollingCount} tentativas (${Math.round(elapsedMs/1000)}s)` }}];\n}\nif (DONE.includes(status)) {\n  return [{ json: { ...$json, routing: 'done', polling_count: pollingCount,\n    elapsed_seconds: Math.round(elapsedMs/1000) }}];\n}\nif (ERRORS.includes(status)) {\n  return [{ json: { ...$json, routing: 'timeout', polling_count: pollingCount,\n    error_message: `Task falhou com status: ${status}` }}];\n}\nreturn [{ json: { ...$json, routing: 'wait', polling_count: pollingCount,\n  elapsed_seconds: Math.round(elapsedMs/1000) }}];"
      }
    },
