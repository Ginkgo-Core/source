      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.manus.ai/v1/tasks",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={\n  \"prompt\": \"Analise e transcreva completamente o conteúdo deste documento. Extraia todo o texto, tabelas, listas e informações relevantes. Retorne o conteúdo completo de forma organizada e estruturada em português.\",\n  \"agentProfile\": \"manus-1.6\",\n  \"taskMode\": \"agent\",\n  \"hideInTaskList\": true,\n  \"attachments\": [\n    {\n      \"type\": \"file_id\",\n      \"file_id\": \"{{ $json.file_id }}\"\n    }\n  ]\n}",
        "options": {}
      },
      "credentials": {
