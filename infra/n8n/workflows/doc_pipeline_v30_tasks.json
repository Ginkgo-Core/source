{
  "name": "Doc Pipeline v30 - Manus Tasks API",
  "nodes": [
    {
      "id": "92d821fe-1012-46ab-b573-0c7341755ec1",
      "name": "Download Document",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        128,
        1072
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.document_url }}",
        "responseFormat": "file",
        "options": {}
      }
    },
    {
      "id": "8818b207-f380-4955-a8e5-2129621549e1",
      "name": "Doc → Base64",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        352,
        1072
      ],
      "parameters": {
        "jsCode": "\nconst item = $input.item;\nconst binaryData = item.binary?.data;\n\nif (!binaryData) {\n  throw new Error('Nenhum dado binário encontrado no input');\n}\n\n// Pega o buffer binário e converte para base64\nconst buffer = await this.helpers.getBinaryDataBuffer(item, 'data');\nconst base64 = buffer.toString('base64');\n\n// Extrai metadados do arquivo\nconst fileName = binaryData.fileName || 'documento.pdf';\nconst mimeType = binaryData.mimeType || 'application/pdf';\nconst fileSize = buffer.length;\n\nreturn [{\n  json: {\n    ...item.json,\n    fileBase64: base64,\n    fileName: fileName,\n    mimeType: mimeType,\n    fileSize: fileSize\n  },\n  binary: item.binary\n}];\n"
      }
    },
    {
      "id": "d2b5dd19-87b7-4fde-abfc-c459a82455c7",
      "name": "HTTP Upload Manus",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        576,
        1072
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.manus.ai/v1/files",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={\n  \"filename\": \"{{ $json.fileName }}\"\n}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "manus-api-key",
          "name": "Manus API Key"
        }
      }
    },
    {
      "id": "da05e77c-9f1a-4a8f-8472-ba8070a92f61",
      "name": "PUT Upload S3",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        1072
      ],
      "parameters": {
        "jsCode": "\n// Pega dados dos nós anteriores\nconst uploadUrl = $('HTTP Upload Manus').item.json.upload_url;\nconst fileId    = $('HTTP Upload Manus').item.json.id;\nconst base64    = $('Doc → Base64').item.json.fileBase64;\nconst mimeType  = $('Doc → Base64').item.json.mimeType;\nconst fileName  = $('Doc → Base64').item.json.fileName;\n\nif (!uploadUrl) throw new Error('upload_url não encontrado');\nif (!base64)    throw new Error('fileBase64 não encontrado');\n\n// Converte base64 para buffer e faz PUT para o S3\nconst buffer = Buffer.from(base64, 'base64');\n\nconst response = await this.helpers.request({\n  method: 'PUT',\n  url: uploadUrl,\n  body: buffer,\n  headers: {\n    'Content-Type': mimeType\n  },\n  encoding: null,\n  resolveWithFullResponse: true\n});\n\nreturn [{\n  json: {\n    file_id: fileId,\n    upload_status: response.statusCode,\n    fileName: fileName,\n    mimeType: mimeType,\n    numero_lead: $input.item.json.numero_lead || null\n  }\n}];\n"
      }
    },
    {
      "id": "44699205-24b8-4509-bace-e9344fb1e12f",
