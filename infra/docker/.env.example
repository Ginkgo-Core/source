# ═══════════════════════════════════════════════════════════════════
# Ginkgo Leaf — Docker Infrastructure Environment Variables
# Copy to .env and fill all values before running docker compose up
# ═══════════════════════════════════════════════════════════════════

# ─── DOMAIN ─────────────────────────────────────────────────────────
DOMAIN=ginkgosystems.tech

# ─── TRAEFIK ────────────────────────────────────────────────────────
ACME_EMAIL=
TRAEFIK_LOG_LEVEL=INFO

# ─── REDIS ──────────────────────────────────────────────────────────
REDIS_PASSWORD=

# ─── N8N ────────────────────────────────────────────────────────────
N8N_HOST=n8n.ginkgosystems.tech
N8N_ENCRYPTION_KEY=
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=
# n8n database (Supabase pooler or dedicated)
N8N_DB_HOST=
N8N_DB_PORT=5432
N8N_DB_NAME=n8n
N8N_DB_USER=
N8N_DB_PASSWORD=

# ─── EVOLUTION API ──────────────────────────────────────────────────
EVOLUTION_HOST=wa.ginkgosystems.tech
EVOLUTION_API_KEY=
EVOLUTION_DATABASE_URL=

# ─── CHATWOOT ───────────────────────────────────────────────────────
CHATWOOT_HOST=chat.ginkgosystems.tech
CHATWOOT_SECRET_KEY_BASE=
CHATWOOT_DATABASE_URL=
# SMTP for Chatwoot emails
CHATWOOT_MAILER_SENDER=noreply@ginkgosystems.tech
CHATWOOT_SMTP_ADDRESS=
CHATWOOT_SMTP_PORT=587
CHATWOOT_SMTP_USERNAME=
CHATWOOT_SMTP_PASSWORD=
